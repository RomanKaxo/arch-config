#!/usr/bin/env python3
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

try:
    configured = json.loads((Path.home() / '.config/desktop/brightness-monitors.json').read_text())
except (OSError, ValueError):
    configured = {}
MONITORS = {key: (name, configured.get(key, '')) for key, name in [('aoc', 'AOC'), ('msi', 'MSI')]}

def monitor_bus():
    with route_lock.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            routes = json.loads(route_cache.read_text())
            if time.time() - routes["time"] < 300 and serial in routes["buses"]:
                return routes["buses"][serial]
        except (OSError, ValueError, KeyError):
            pass
        result = subprocess.run(["ddcutil", "detect", "--terse"], capture_output=True, text=True, timeout=15)
        buses = {}
        for block in re.split(r"(?m)^Display ", result.stdout):
            bus = re.search(r"I2C bus:\s+/dev/i2c-(\d+)", block)
            for _, monitor_serial in MONITORS.values():
                if bus and re.search(r"Monitor:.*:" + re.escape(monitor_serial) + r"\s*$", block, re.MULTILINE):
                    buses[monitor_serial] = int(bus[1])
        if serial not in buses:
            raise RuntimeError("Monitor nebyl nalezen přes DDC/CI")
        route_cache.write_text(json.dumps({"time": time.time(), "buses": buses}))
        return buses[serial]

def run(*args):
    global bus
    if bus is None:
        bus = monitor_bus()
    options = ["ddcutil", "--bus", str(bus), "--skip-ddc-checks"]
    if args[0] == "setvcp":
        options.append("--noverify")
    result = subprocess.run([*options, *args], capture_output=True, text=True, timeout=15)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    return result.stdout

def read():
    match = re.search(r"VCP\s+10\s+C\s+(\d+)\s+(\d+)", run("getvcp", "10", "--terse"))
    if not match:
        raise RuntimeError("Monitor neposkytl hodnotu jasu")
    return tuple(map(int, match.groups()))

def cached_read(max_age):
    try:
        data = json.loads(cache.read_text())
        if 0 <= time.time() - data["time"] < max_age and data["maximum"] > 0:
            return data["current"], data["maximum"]
    except (OSError, ValueError, KeyError):
        pass
    return read()

def save(current, maximum):
    cache.write_text(json.dumps({"time": time.time(), "current": current, "maximum": maximum}))

if __name__ == "__main__":
    key = sys.argv[1]
    name, serial = MONITORS[key]
    action = sys.argv[2] if len(sys.argv) > 2 else "status"
    if action == 'configured':
        raise SystemExit(0 if serial else 1)
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"desktop-brightness-{os.getuid()}-{key}.lock"
    cache = runtime.with_suffix(".json")
    route_cache = runtime.parent / f"desktop-brightness-{os.getuid()}-routes.json"
    route_lock = route_cache.with_suffix(".lock")
    try:
        if not shutil.which("ddcutil"):
            raise RuntimeError("Chybí ddcutil — klikni pro instalaci")
        if not serial:
            raise RuntimeError('Doplň sériové číslo do ~/.config/desktop/brightness-monitors.json')
        with runtime.open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            bus = None
            current, maximum = cached_read(0 if action == "refresh" else (60 if action != "status" else 10))
            if action in ("up", "down"):
                step = max(1, round(maximum * 0.05))
                target = max(0, min(maximum, current + (step if action == "up" else -step)))
                if target != current:
                    run("setvcp", "10", str(target))
                current = target
            elif action == "set":
                percent = max(0, min(100, int(sys.argv[3])))
                target = round(maximum * percent / 100)
                if target != current:
                    run("setvcp", "10", str(target))
                current = target
            if action != "status" or not cache.exists() or time.time() - cache.stat().st_mtime >= 10:
                save(current, maximum)
            percent = round(current * 100 / maximum)
            print(json.dumps({"text": f"󰃠 {percent}%", "percentage": percent, "tooltip": f"Jas {name}: {percent}%\nKlik: slidery monitorů · kolečko: ±5 %", "class": "available"}, ensure_ascii=False))
    except (RuntimeError, OSError, subprocess.TimeoutExpired, ZeroDivisionError) as error:
        cache.unlink(missing_ok=True)
        route_cache.unlink(missing_ok=True)
        print(json.dumps({"text": f"󰃠 {name} —", "tooltip": f"Jas {name} není dostupný.\n{str(error)[:500]}\nMonitor musí mít zapnuté DDC/CI.", "class": "unavailable"}, ensure_ascii=False))
        if action != "status":
            if not shutil.which("ddcutil"):
                subprocess.Popen(["kitty", "--title", "Ovládání jasu monitorů", "--hold", str(Path.home() / ".local/bin/desktop-brightness-setup")])
            else:
                subprocess.run(["notify-send", "Jas monitoru", f"{name}: ovládání přes DDC/CI není dostupné."], check=False)
