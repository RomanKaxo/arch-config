#!/usr/bin/env python3
"""A desktop mixer backed by PipeWire's PulseAudio interface."""
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import threading
import time

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib
GLib.set_prgname('desktop-sound-control')

runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp'))
lock = open(runtime / f'desktop-sound-control-{os.getuid()}.lock', 'a+')
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    lock.seek(0)
    try:
        pid = int(lock.read())
        if b'desktop-sound-control' in Path(f'/proc/{pid}/cmdline').read_bytes():
            os.kill(pid, signal.SIGUSR1)
    except (OSError, ValueError):
        pass
    raise SystemExit(0)
lock.seek(0)
lock.truncate()
lock.write(str(os.getpid()))
lock.flush()

def pactl(*args):
    result = subprocess.run(['pactl', *args], capture_output=True, text=True, timeout=5)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Zvukový server není dostupný')
    return result.stdout.strip()

condition = threading.Condition()
pending = {}
stopped = False

def enqueue(key, *args):
    with condition:
        pending[key] = args
        condition.notify()

window = Gtk.Window(title='Zvuk')
window.set_default_size(560, 560)
window.set_size_request(460, 400)
window.set_position(Gtk.WindowPosition.CENTER)
window.get_style_context().add_class('sound-window')
header = Gtk.HeaderBar(title='Zvuk', subtitle='Zařízení a aplikace')
header.set_show_close_button(True)
window.set_titlebar(header)
window.connect('destroy', lambda *_: Gtk.main_quit())
window.connect('key-press-event', lambda w, e: w.destroy() if e.keyval == Gdk.KEY_Escape else False)
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda: (window.present(), True)[1])
css = Gtk.CssProvider()
css.load_from_data(b'''
.sound-window, .sound-window headerbar { background: #101010; color: #dedede; font-family: Inter; }
.sound-window headerbar { border-bottom: 1px solid #292929; box-shadow: none; padding: 9px 14px; }
.sound-window button { background: #252525; color: #dedede; border: 1px solid #383838; border-radius: 9px; box-shadow: none; text-shadow: none; padding: 7px 12px; }
.sound-window button:hover { background: #363636; }
.sound-window button:checked { background: #444444; border-color: #777777; }
.sound-window .audio-card { background: #1b1b1b; border: 1px solid #303030; border-radius: 15px; padding: 16px; }
.sound-window .card-title { font-size: 14px; font-weight: 600; }
.sound-window .muted { color: #999999; font-size: 11px; }
.sound-window .percent { color: #cccccc; font-size: 12px; }
.sound-window scale { padding: 10px 0; }
.sound-window scale trough { background: #373737; min-height: 5px; border: none; border-radius: 5px; }
.sound-window scale highlight { background: #cccccc; border: none; border-radius: 5px; }
.sound-window scale slider { background: #eeeeee; border: none; box-shadow: none; min-width: 16px; min-height: 16px; border-radius: 50%; }
.sound-window combobox button { padding: 5px 10px; }
''')
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
root.set_border_width(20)
window.add(root)
stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=120)
switcher = Gtk.StackSwitcher(stack=stack, halign=Gtk.Align.CENTER)
root.pack_start(switcher, False, False, 0)
root.pack_start(stack, True, True, 0)
pages = {}
rows = {}
for name, title in [('output', 'Výstup'), ('input', 'Mikrofon'), ('apps', 'Aplikace'), ('profiles', 'Profily')]:
    scroller = Gtk.ScrolledWindow()
    scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    scroller.add(container)
    stack.add_titled(scroller, name, title)
    pages[name] = container
    rows[name] = {}
status = Gtk.Label(label='Načítám zvuková zařízení…', xalign=0)
status.get_style_context().add_class('muted')
root.pack_end(status, False, False, 0)

def label(text, style=None):
    widget = Gtk.Label(label=text, xalign=0)
    widget.set_ellipsize(3)
    if style:
        widget.get_style_context().add_class(style)
    return widget

class AudioCard(Gtk.Box):
    def __init__(self, kind, node):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.get_style_context().add_class('audio-card')
        self.kind, self.index = kind, str(node['index'])
        self.syncing, self.dragging, self.changed_at = False, False, 0
        self.title = label('', 'card-title')
        self.subtitle = label('', 'muted')
        self.pack_start(self.title, False, False, 0)
        self.pack_start(self.subtitle, False, False, 0)
        line = Gtk.Box(spacing=12)
        self.mute = Gtk.ToggleButton(label='Ztlumit')
        self.mute.connect('toggled', self.mute_changed)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.scale.connect('value-changed', self.volume_changed)
        self.scale.connect('button-press-event', self.pressed)
        self.scale.connect('button-release-event', self.released)
        self.percent = label('', 'percent')
        self.percent.set_width_chars(5)
        line.pack_start(self.scale, True, True, 0)
        line.pack_end(self.percent, False, False, 0)
        self.pack_start(line, False, False, 0)
        controls = Gtk.Box(spacing=8)
        controls.pack_start(self.mute, False, False, 0)
        self.choose = Gtk.ComboBoxText()
        self.choose.set_hexpand(True)
        self.choose.connect('changed', self.choice_changed)
        controls.pack_end(self.choose, True, True, 0)
        self.pack_start(controls, False, False, 0)
        self.default = None
        if kind in ('sink', 'source'):
            self.default = Gtk.Button(label='Použít jako výchozí')
            self.default.connect('clicked', lambda *_: enqueue((kind, 'default'), 'set-default-' + kind, self.node['name']))
            self.pack_start(self.default, False, False, 0)
        self.node = node
        self.choices = None

    def pressed(self, *_):
        self.dragging = True
        return False

    def released(self, *_):
        self.dragging = False
        self.changed_at = time.monotonic()
        return False

    def volume_changed(self, widget):
        value = round(widget.get_value())
        self.percent.set_text(f'{value} %')
        if not self.syncing:
            self.changed_at = time.monotonic()
            enqueue((self.kind, self.index, 'volume'), 'set-' + self.kind + '-volume', self.index, f'{value}%')

    def mute_changed(self, widget):
        widget.set_label('Zapnout zvuk' if widget.get_active() else 'Ztlumit')
        if not self.syncing:
            self.changed_at = time.monotonic()
            enqueue((self.kind, self.index, 'mute'), 'set-' + self.kind + '-mute', self.index, '1' if widget.get_active() else '0')

    def choice_changed(self, widget):
        value = widget.get_active_id()
        if self.syncing or not value:
            return
        self.changed_at = time.monotonic()
        if self.kind in ('sink', 'source'):
            enqueue((self.kind, self.index, 'port'), 'set-' + self.kind + '-port', self.index, value)
        else:
            enqueue((self.kind, self.index, 'device'), 'move-' + self.kind, self.index, value)

    def update(self, node, state):
        self.node = node
        self.syncing = True
        props = node.get('properties', {})
        self.title.set_text(node.get('description') or props.get('application.process.binary') or props.get('application.name', 'Aplikace'))
        self.subtitle.set_text(props.get('media.name', '') if self.kind.endswith(('input', 'output')) else ('Výchozí zařízení' if node.get('name') == state.get('default_' + self.kind) else 'Zvukové zařízení'))
        if not self.dragging and time.monotonic() - self.changed_at > 1:
            values = [v['value'] for v in node.get('volume', {}).values()]
            value = round(sum(values) / len(values) * 100 / 65536) if values else 0
            self.scale.set_value(min(100, value))
            self.percent.set_text(f'{value} %')
            self.mute.set_active(node.get('mute', False))
            self.mute.set_label('Zapnout zvuk' if node.get('mute') else 'Ztlumit')
            if self.kind in ('sink', 'source'):
                ports = node.get('ports', [])
                choices = [(p['name'], p['description']) for p in ports]
                if choices != self.choices:
                    self.choose.remove_all()
                    for identifier, description in choices:
                        self.choose.append(identifier, description)
                    self.choices = choices
                self.choose.set_active_id(node.get('active_port', ''))
                self.choose.set_visible(len(ports) > 1)
            else:
                target = 'sink' if self.kind == 'sink-input' else 'source'
                choices = [(str(d['index']), d['description']) for d in state[target + 's']]
                if choices != self.choices:
                    self.choose.remove_all()
                    for identifier, description in choices:
                        self.choose.append(identifier, description)
                    self.choices = choices
                self.choose.set_active_id(str(node[target]))
            if self.default:
                is_default = node['name'] == state.get('default_' + self.kind)
                self.default.set_label('✓ Výchozí zařízení' if is_default else 'Použít jako výchozí')
                self.default.set_sensitive(not is_default)
        self.syncing = False

def render(state):
    specs = {
        'output': [('sink', n) for n in state['sinks']],
        'input': [('source', n) for n in state['sources'] if not n['name'].endswith('.monitor')],
        'apps': [('sink-input', n) for n in state['sink-inputs']] + [('source-output', n) for n in state['source-outputs']],
    }
    for page, nodes in specs.items():
        wanted = {(kind, str(n['index'])) for kind, n in nodes}
        for key in list(rows[page]):
            if key not in wanted:
                rows[page].pop(key).destroy()
        for kind, node in nodes:
            key = kind, str(node['index'])
            if key not in rows[page]:
                row = AudioCard(kind, node)
                rows[page][key] = row
                pages[page].pack_start(row, False, False, 0)
                row.show_all()
            rows[page][key].update(node, state)
    for card in state['cards']:
        key = card['name']
        profiles = card.get('profiles', [])
        if isinstance(profiles, dict):
            profiles = [dict(v, name=k) for k, v in profiles.items()]
        signature = (card.get('active_profile'), tuple(p['name'] for p in profiles))
        if key in rows['profiles'] and rows['profiles'][key][1] == signature:
            continue
        if key in rows['profiles']:
            rows['profiles'].pop(key)[0].destroy()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.get_style_context().add_class('audio-card')
        box.pack_start(label(card.get('properties', {}).get('device.description', key), 'card-title'), False, False, 0)
        combo = Gtk.ComboBoxText()
        for profile in profiles:
            combo.append(profile['name'], profile.get('description', profile['name']))
        active = card.get('active_profile', '')
        combo.set_active_id(active.get('name', '') if isinstance(active, dict) else active)
        combo.connect('changed', lambda w, k=key: enqueue(('profile', k), 'set-card-profile', k, w.get_active_id()) if w.get_active_id() else None)
        box.pack_start(combo, False, False, 0)
        pages['profiles'].pack_start(box, False, False, 0)
        rows['profiles'][key] = box, signature
        box.show_all()
    for key in list(rows['profiles']):
        if key not in {c['name'] for c in state['cards']}:
            rows['profiles'].pop(key)[0].destroy()
    status.set_text('Aplikace se zobrazí, když přehrává nebo nahrává zvuk.' if not specs['apps'] else 'Změny se použijí okamžitě.')
    return False

def backend():
    next_poll = 0
    while not stopped:
        with condition:
            if not pending and time.monotonic() < next_poll:
                condition.wait(timeout=next_poll - time.monotonic())
            commands = list(pending.values())
            pending.clear()
        for args in commands:
            try:
                pactl(*args)
            except Exception as exc:
                GLib.idle_add(status.set_text, str(exc))
        if time.monotonic() >= next_poll:
            try:
                state = {kind: json.loads(pactl('-f', 'json', 'list', kind)) for kind in ('sinks', 'sources', 'sink-inputs', 'source-outputs', 'cards')}
                state['default_sink'] = pactl('get-default-sink')
                state['default_source'] = pactl('get-default-source')
                GLib.idle_add(render, state)
            except Exception as exc:
                GLib.idle_add(status.set_text, str(exc))
            next_poll = time.monotonic() + 1.5
        # Coalesce slider events arriving while a command is in flight.
        with condition:
            if pending:
                condition.wait(timeout=0.04)

threading.Thread(target=backend, daemon=True).start()
window.show_all()
Gtk.main()
stopped = True
with condition:
    condition.notify()
