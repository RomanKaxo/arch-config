#!/usr/bin/env python
"""Udržuje tapetu zamykací obrazovky podle hlavního monitoru Waypaperu."""

import os
import sys
from pathlib import Path

# Druhý monitor může mít vlastní tapetu; zámek používá hlavní monitor nebo All.
if len(sys.argv) > 2 and sys.argv[2] not in ("All", "DP-2"):
    raise SystemExit(0)
selected = Path(sys.argv[1]).expanduser().resolve(strict=True)
if not selected.is_file():
    raise SystemExit("Tapeta není soubor.")
folder = Path.home() / ".local/share/wallpapers"
temporary = folder / (".waypaper-current-" + str(os.getpid()))
temporary.symlink_to(selected)
os.replace(temporary, folder / "current.png")
